# Flask 웹 서버 환경 설정
FLASK_APP=app.py
FLASK_DEBUG=True
SECRET_KEY=your_flask_secret_key_here

# Google Gemini API Key (발급처: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# 보안 PIN 설정 (4자리)
ACCESS_PIN=0927

# 공공데이터포털(data.go.kr) API 일반 인증키 (필요 시 입력)
PUBLIC_DATA_API_KEY=your_public_data_api_key_here
